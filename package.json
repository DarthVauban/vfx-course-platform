{
  "name": "vfx-course-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:generate": "node scripts/generate-course-data.mjs",
    "predev": "npm run content:generate",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run content:generate",
    "build": "tsc -b && vite build",
    "pretest": "npm run content:generate",
    "test": "vitest run",
